# Plantilla de variables. Nada carga este archivo automáticamente:
# exporta las variables en tu terminal o usa `node --env-file=.env`. Nunca versiones un .env real.
# En CI los valores vienen de los ambientes de GitHub (Settings > Environments): ci, qa, staging.

# --- Aplicación ---
PORT=3000
DATABASE_PATH=./src/data/quality-lab.json
RISK_SERVICE_URL=http://127.0.0.1:3000/external/risk
# SECRETO. En CI: secreto RISK_API_TOKEN del ambiente de GitHub.
RISK_API_TOKEN=replace-me
# approved | rejected | random. Las pruebas E2E usan approved por defecto (variable RISK_MODE del ambiente).
RISK_MODE=random

# --- Pruebas E2E (Playwright) ---
# Vacía: levanta una instancia local aislada. Con valor: prueba ese ambiente (variable BASE_URL del ambiente).
BASE_URL=
# Puerto de la instancia local de pruebas.
TEST_PORT=3100
# Vacía: semilla aleatoria. Con valor: reproduce los datos de una ejecución anterior.
DATA_SEED=
# true conserva la BD de prueba al terminar, para depurar.
KEEP_TEST_DATA=false

# --- Rendimiento (k6) ---
VUS=50
DURATION=5m
THINK_TIME=1
CLIENT_ID=1
